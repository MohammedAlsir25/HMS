# ⚠️  NEVER commit .env — it contains real production credentials.
#    Generate fresh keys for local dev; rotate any secrets that were
#    ever persisted in .env before this project went public.
#
# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/db"
DIRECT_URL="postgresql://user:password@host:5432/db"

# ─── Server ─────────────────────────────────────────────
PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Encryption ─────────────────────────────────────────
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=jh-uploads

# ─── Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MEDICINE_PROMPT=optional custom prompt
# GEMINI_DENTAL_PROMPT=optional custom prompt
# GEMINI_ENT_PROMPT=optional custom prompt
# GEMINI_RETINA_PROMPT=optional custom prompt
# GEMINI_GLAUCOMA_PROMPT=optional custom prompt
# GEMINI_MEDICAL_PROMPT=optional custom prompt
