NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hms
DIRECT_URL=postgresql://user:password@localhost:5432/hms

# JWT (staff)
JWT_SECRET=your-staff-jwt-secret-here
JWT_REFRESH_SECRET=your-staff-jwt-refresh-secret-here
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# JWT (patient portal)
PATIENT_JWT_SECRET=your-patient-portal-jwt-secret-here
PATIENT_JWT_EXPIRY=7d

# Encryption
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Supabase (file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=hospital-files

# Gemini AI (optional)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# Tap Payment Gateway (optional — mock mode when not set)
TAP_API_KEY=sk_test_your-tap-api-key
TAP_WEBHOOK_SECRET=your-tap-webhook-secret

# Currency
DEFAULT_CURRENCY=SDG

# Redis (for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# FHIR Server
FHIR_SERVER_URL=http://localhost:3000/api/fhir/R4
FHIR_AUTH_MODE=jwt
FHIR_JWT_SECRET=
SMART_ON_FHIR_CLIENT_ID=
SMART_ON_FHIR_CLIENT_SECRET=
