  hospitalId         String?
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @updatedAt @db.Timestamptz(6)
  patient            Patient            @relation(fields: [patientId], references: [id])
  insuranceCompany   InsuranceCompany   @relation(fields: [insuranceCompanyId], references: [id])
  hospital           Hospital?          @relation(fields: [hospitalId], references: [id])
  preAuthorizations  PreAuthorization[]
  claims             InsuranceClaim[]

  @@unique([hospitalId, patientId, insuranceCompanyId, policyNumber])
  @@index([patientId])
  @@index([insuranceCompanyId])
  @@index([hospitalId])
  @@index([hospitalId, patientId, isActive])
  @@map("insurance_policies")
}

model InsurancePricingRule {
  id                 String           @id @default(uuid())
  insuranceCompanyId String
  serviceItemId      String?
  itemType           String
  itemName           String
  standardPrice      Decimal          @db.Decimal(12, 2)
  insurancePrice     Decimal          @db.Decimal(12, 2)
  isActive           Boolean          @default(true)
  hospitalId         String?
  created_at         DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @updatedAt @db.Timestamptz(6)
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  hospital           Hospital?        @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, insuranceCompanyId, itemType, itemName])
  @@index([insuranceCompanyId])
  @@index([hospitalId])
  @@map("insurance_pricing_rules")
}

model PreAuthorization {
  id                 String                 @id @default(uuid())
  referenceNumber    String
  patientId          String
  insurancePolicyId  String
  insuranceCompanyId String
  status             PreAuthorizationStatus @default(SUBMITTED)
  diagnosis          String
  diagnosisCode      String?
  plannedProcedures  Json
  estimatedTotalCost Decimal                @db.Decimal(12, 2)
  approvedAmount     Decimal?               @db.Decimal(12, 2)
  clinicalNotes      String?
  rejectionReason    String?
  submittedById      String
  reviewedById       String?
  submittedAt        DateTime               @default(now())
  reviewedAt         DateTime?
  expiresAt          DateTime?
  hospitalId         String?
  created_at         DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at         DateTime               @updatedAt @db.Timestamptz(6)
  patient            Patient                @relation(fields: [patientId], references: [id])
  insurancePolicy    InsurancePolicy        @relation(fields: [insurancePolicyId], references: [id])
  insuranceCompany   InsuranceCompany       @relation(fields: [insuranceCompanyId], references: [id])
  submittedBy        User                   @relation("SubmittedPreAuth", fields: [submittedById], references: [id])
  reviewedBy         User?                  @relation("ReviewedPreAuth", fields: [reviewedById], references: [id])
  hospital           Hospital?              @relation(fields: [hospitalId], references: [id])
  claims             InsuranceClaim[]

  @@unique([hospitalId, referenceNumber])
  @@index([patientId])
  @@index([insuranceCompanyId])
  @@index([status])
  @@index([hospitalId])
  @@index([hospitalId, status])
  @@index([submittedById])
  @@index([insurancePolicyId])
  @@map("pre_authorizations")
}

model InsuranceClaim {
  id                 String                @id @default(uuid())
  claimNumber        String
  patientId          String
  insurancePolicyId  String
  insuranceCompanyId String
  invoiceId          String?
  preAuthorizationId String?
  status             ClaimStatus           @default(DRAFT)
  claimAmount        Decimal               @db.Decimal(12, 2)
  approvedAmount     Decimal?              @db.Decimal(12, 2)
  paidAmount         Decimal               @default(0) @db.Decimal(12, 2)
  rejectionReason    String?
  denialReasonCode   String?
  denialReasonText   String?
  clinicalRecords    Json?
  labResults         Json?
  imagingResults     Json?
  submittedAt        DateTime?
  settledAt          DateTime?
  notes              String?
  createdById        String
  hospitalId         String?
  created_at         DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime              @updatedAt @db.Timestamptz(6)
  patient            Patient               @relation(fields: [patientId], references: [id])
  insurancePolicy    InsurancePolicy       @relation(fields: [insurancePolicyId], references: [id])
  insuranceCompany   InsuranceCompany      @relation(fields: [insuranceCompanyId], references: [id])
  invoice            Invoice?              @relation(fields: [invoiceId], references: [id])
  preAuthorization   PreAuthorization?     @relation(fields: [preAuthorizationId], references: [id])
  createdBy          User                  @relation("CreatedClaim", fields: [createdById], references: [id])
  hospital           Hospital?             @relation(fields: [hospitalId], references: [id])
  settlements        InsuranceSettlement[]
  denialAppeals      DenialAppeal[]

  @@unique([hospitalId, claimNumber])
  @@index([patientId])
  @@index([insuranceCompanyId])
  @@index([status])
  @@index([invoiceId])
  @@index([hospitalId])
  @@index([hospitalId, status])
  @@index([hospitalId, patientId])
  @@index([hospitalId, insuranceCompanyId])
  @@index([createdById])
  @@index([preAuthorizationId])
  @@map("insurance_claims")
}

model InsuranceSettlement {
  id                 String           @id @default(uuid())
  claimId            String
  insuranceCompanyId String
  amount             Decimal          @db.Decimal(12, 2)
  settlementDate     DateTime
  referenceNumber    String?
  paymentMethod      String?
  notes              String?
  adjustmentReason   String?
  createdById        String
  hospitalId         String?
  created_at         DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @updatedAt @db.Timestamptz(6)
  claim              InsuranceClaim   @relation(fields: [claimId], references: [id])
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  createdBy          User             @relation("CreatedSettlement", fields: [createdById], references: [id])
  hospital           Hospital?        @relation(fields: [hospitalId], references: [id])

  @@index([claimId])
  @@index([insuranceCompanyId])
  @@index([hospitalId])
  @@index([createdById])
  @@map("insurance_settlements")
}

model PaymentPlan {
  id                   String               @id @default(uuid())
  patientId            String
  invoiceId            String?
  totalAmount          Decimal              @db.Decimal(12, 2)
  numberOfInstallments Int
  installmentAmount    Decimal              @db.Decimal(12, 2)
  frequency            PaymentPlanFrequency @default(MONTHLY)
  startDate            DateTime
  status               PaymentPlanStatus    @default(ACTIVE)
  notes                String?
  hospitalId           String?
  createdById          String?
  created_at           DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @updatedAt
  patient              Patient              @relation(fields: [patientId], references: [id])
  hospital             Hospital?            @relation(fields: [hospitalId], references: [id])
  createdBy            User?                @relation("PlanCreator", fields: [createdById], references: [id])
  installments         PaymentInstallment[]

  @@index([patientId])
  @@index([status])
  @@index([hospitalId])
  @@map("payment_plans")
}

model PaymentInstallment {
  id                String            @id @default(uuid())
  planId            String
  installmentNumber Int
  amount            Decimal           @db.Decimal(12, 2)
  dueDate           DateTime
  paidDate          DateTime?
  amountPaid        Decimal?          @db.Decimal(12, 2)
  status            InstallmentStatus @default(PENDING)
  transactionId     String?
  notes             String?
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @updatedAt
  plan              PaymentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
  @@index([dueDate])
  @@map("payment_installments")
}

model CreditMemo {
  id          String           @id @default(uuid())
  memoNumber  String
  invoiceId   String
  amount      Decimal          @db.Decimal(12, 2)
  reason      String
  type        CreditMemoType   @default(CREDIT)
  status      CreditMemoStatus @default(PENDING)
  hospitalId  String?
  createdById String
  created_at  DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at  DateTime         @updatedAt
  invoice     Invoice          @relation(fields: [invoiceId], references: [id])
  hospital    Hospital?        @relation(fields: [hospitalId], references: [id])
  createdBy   User             @relation("CreditMemoCreator", fields: [createdById], references: [id])

  @@unique([hospitalId, memoNumber])
  @@index([invoiceId])
  @@index([status])
  @@index([hospitalId])
  @@map("credit_memos")
}

model Refund {
  id            String       @id @default(uuid())
  refundNumber  String
  invoiceId     String
  transactionId String?
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  status        RefundStatus @default(PENDING)
  refundMethod  String       @default("ORIGINAL")
  hospitalId    String?
  createdById   String
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt
  invoice       Invoice      @relation(fields: [invoiceId], references: [id])
  hospital      Hospital?    @relation(fields: [hospitalId], references: [id])
  createdBy     User         @relation("RefundCreator", fields: [createdById], references: [id])

  @@unique([hospitalId, refundNumber])
  @@index([invoiceId])
  @@index([status])
  @@index([hospitalId])
  @@map("refunds")
}

model BadDebtWriteOff {
  id           String    @id @default(uuid())
  invoiceId    String
  amount       Decimal   @db.Decimal(12, 2)
  reason       String
  writeOffDate DateTime  @default(now())
  hospitalId   String?
  createdById  String
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  invoice      Invoice   @relation(fields: [invoiceId], references: [id])
  hospital     Hospital? @relation(fields: [hospitalId], references: [id])
  createdBy    User      @relation("WriteOffCreator", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([hospitalId])
  @@index([writeOffDate])
  @@map("bad_debt_write_offs")
}

model DenialAppeal {
  id                 String             @id @default(uuid())
  claimId            String
  appealNumber       String
  status             DenialAppealStatus @default(OPEN)
  denialReasonCode   String
  denialReasonText   String?
  appealNotes        String?
  correctedClaimData Json?
  submittedAt        DateTime?
  resolvedAt         DateTime?
  hospitalId         String?
  createdById        String
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @updatedAt
  claim              InsuranceClaim     @relation(fields: [claimId], references: [id])
  hospital           Hospital?          @relation(fields: [hospitalId], references: [id])
  createdBy          User               @relation("AppealCreator", fields: [createdById], references: [id])

  @@unique([hospitalId, appealNumber])
  @@index([claimId])
  @@index([status])
  @@index([hospitalId])
  @@map("denial_appeals")
}

model DenialReason {
  id          String    @id @default(uuid())
  code        String
  description String
  category    String?
  isActive    Boolean   @default(true)
  hospitalId  String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@map("denial_reasons")
}

enum GenderType {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

model FhirEndpoint {
  id              String    @id @default(uuid())
  name            String
  baseUrl         String
  authType        String    @default("bearer")
  authConfig      Json      @default("{}")
  status          String    @default("active")
  lastSyncAt      DateTime?
  errorCount      Int       @default(0)
  lastError       String?
  description     String?
  hospitalId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  hospital        Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@map("fhir_endpoints")
}
