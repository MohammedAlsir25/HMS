generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  id                     String                @id @default(uuid())
  email                  String                @unique
  passwordHash           String
  fullName               String
  phone                  String?
  avatarUrl              String?
  isActive               Boolean               @default(true)
  lastLogin              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  roleId                 String
  clinicId               String?
  appointments           Appointment[]
  auditLogs              AuditLog[]
  enteredResults         DiagnosticOrderTest[] @relation("ResultEnterer")
  assignedOrders         DiagnosticOrder[]     @relation("OrderAssignee")
  requestedOrders        DiagnosticOrder[]     @relation("OrderRequester")
  paidOrders             DiagnosticOrder[]     @relation("OrderPaidBy")
  employees              Employee[]
  approvedLeaves         LeaveRequest[]        @relation("LeaveApprover")
  notifications          Notification[]
  createdPatients        Patient[]             @relation("PatientCreator")
  approvedPurchaseOrders PurchaseOrder[]       @relation("POApprover")
  createdPurchaseOrders  PurchaseOrder[]       @relation("POCreator")
  createdRequisitions    Requisition[]         @relation("RequisitionCreator")
  shifts                 Shift[]
  createdInvoices        SupplierInvoice[]
  cashierTransactions    Transaction[]         @relation("Cashier")
  clinic                 Clinic?               @relation(fields: [clinicId], references: [id])
  role                   Role                  @relation(fields: [roleId], references: [id])
  opticLabCompletedBy    OpticLabJob[]         @relation("OpticLabCompletedBy")
  opticLabCreatedBy      OpticLabJob[]         @relation("OpticLabCreatedBy")
  surgeryTeamMembers     SurgeryTeamMember[]
  createdFollowUps       PostOpFollowUp[]
  postoperativeNotes     PostoperativeNote[]
  dischargeSummaries     DischargeSummary[]
  inpatientVitals        InpatientVital[]
  nursingNotes           NursingNote[]
  wardRounds             WardRound[]
  cashMovements          CashMovement[]

  @@index([isActive])
  @@index([roleId])
  @@index([clinicId])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  permissions Json      @default("{}")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  is_deleted  Boolean?  @default(false)
  users       User[]

  @@index([is_deleted])
  @@map("roles")
}

model Clinic {
  id                            String            @id @default(uuid())
  name                          String
  nameAr                        String?
  slug                          String            @unique
  type                          ClinicType
  isActive                      Boolean           @default(true)
  consultationFee               Decimal?
  followUpFee                   Decimal?
  created_at                    DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime          @updatedAt @db.Timestamptz(6)
  is_deleted                    Boolean?          @default(false)
  optometryPreScreeningRequired Boolean           @default(false)
  appointments                  Appointment[]
  clinicalRecords               ClinicalRecord[]
  departments                   Department[]
  diagnosticOrders              DiagnosticOrder[]
  referralsFrom                 Referral[]        @relation("FromClinic")
  referralsTo                   Referral[]        @relation("ToClinic")
  screeningAppointments         Appointment[]     @relation("TargetClinic")
  users                         User[]

  @@index([isActive])
  @@index([is_deleted])
  @@map("clinics")
}

model Department {
  id           String         @id @default(uuid())
  name         String
  nameAr       String?
  slug         String         @unique
  type         DepartmentType
  isActive     Boolean        @default(true)
  clinicId     String?
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted   Boolean?       @default(false)
  costCenter   CostCenter?
  clinic       Clinic?        @relation(fields: [clinicId], references: [id])
  employees    Employee[]
  expenses     Expense[]
  requisitions Requisition[]
  transactions Transaction[]
  surgeries    Surgery[]
  operationTypes OperationType[]
  preoperativeRequests PreoperativeRequest[]
  wards        Ward[]

  @@index([isActive])
  @@index([is_deleted])
  @@index([clinicId])
  @@map("departments")
}

model Expense {
  id              String           @id @default(uuid())
  amount          Decimal
  category        ExpenseCategory
  description     String
  date            DateTime         @default(now())
  paidTo          String?
  paymentMethod   String?
  notes           String?
  receiptUrl      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  purchaseOrders  PurchaseOrder?
  supplierInvoice SupplierInvoice?

  @@index([date])
  @@index([departmentId])
  @@index([category])
  @@map("expenses")
}

model Patient {
  id                String            @id @default(uuid())
  mrn               String            @unique
  fullName          String
  phone             String?
  nationalId        String?           @unique
  email             String?
  dateOfBirth       DateTime?
  gender            String?
  chronicConditions String[]          @default([])
  address           String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String
  diabetesType      DiabetesType      @default(NONE)
  is_deleted        Boolean?          @default(false)
  appointments      Appointment[]
  clinicalRecords   ClinicalRecord[]
  diagnosticOrders  DiagnosticOrder[]
  files             PatientFile[]
  createdBy         User              @relation("PatientCreator", fields: [createdById], references: [id])
  referrals         Referral[]
  surgeries         Surgery[]
  preoperativeRequests PreoperativeRequest[]
  followUps            PostOpFollowUp[]
  beds                 Bed[]
  transactions         Transaction[]

  @@index([is_deleted])
  @@index([createdAt])
  @@index([createdById])
  @@map("patients")
}

model PatientFile {
  id           String   @id @default(uuid())
  originalName String
  storedPath   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  patientId    String
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  is_deleted   Boolean? @default(false)
  patient      Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([is_deleted])
  @@map("patient_files")
}

model Appointment {
  id                String            @id @default(uuid())
  token             Int
  type              AppointmentType
  status            AppointmentStatus @default(WAITING)
  priority          Int               @default(0)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  patientId         String
  clinicId          String
  doctorId          String
  visitType         VisitType?        @default(NEW_VISIT)
  scheduledAt       DateTime?
  targetClinicId    String?
  optometryRecordId String?
  clinic            Clinic            @relation(fields: [clinicId], references: [id])
  doctor            User              @relation(fields: [doctorId], references: [id])
  patient           Patient           @relation(fields: [patientId], references: [id])
  targetClinic      Clinic?           @relation("TargetClinic", fields: [targetClinicId], references: [id])
  surgeryId         String?
  surgery           Surgery?          @relation(fields: [surgeryId], references: [id])
  transactions      Transaction[]

  @@index([status])
  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([targetClinicId])
  @@index([createdAt])
  @@map("appointments")
}

model Icd10Code {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  category   String?
  createdAt  DateTime @default(now())
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  is_deleted Boolean? @default(false)

  @@index([is_deleted])
  @@index([category])
  @@map("icd10_codes")
}

model VitalSign {
  id                     String         @id @default(uuid())
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  temperature            Decimal?
  spo2                   Int?
  bloodGlucose           Int?
  weight                 Decimal?
  recordedAt             DateTime       @default(now())
  clinicalRecordId       String
  created_at             DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted             Boolean?       @default(false)
  clinicalRecord         ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])

  @@index([clinicalRecordId])
  @@index([is_deleted])
  @@map("vital_signs")
}

model Symptom {
  id               String         @id @default(uuid())
  name             String
  bodyArea         String?
  onset            String?
  duration         String?
  severity         Int?
  description      String?
  clinicalRecordId String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?       @default(false)
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])

  @@index([clinicalRecordId])
  @@index([is_deleted])
  @@map("symptoms")
}

model Medication {
  id               String         @id @default(uuid())
  drugName         String
  dosage           String?
  frequency        String?
  duration         String?
  route            String?
  notes            String?
  clinicalRecordId String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?       @default(false)
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])

  @@index([clinicalRecordId])
  @@index([is_deleted])
  @@map("medications")
}

model ClinicalRecord {
  id                 String       @id @default(uuid())
  encounterDate      DateTime     @default(now())
  diagnosis          String?
  prescriptions      String?
  clinicSpecificJson Json?        @default("{}")
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([createdAt])
  patientId          String
  clinicId           String
  clinic             Clinic       @relation(fields: [clinicId], references: [id])
  patient            Patient      @relation(fields: [patientId], references: [id])
  medications        Medication[]
  symptoms           Symptom[]
  vitalSigns         VitalSign[]

  @@index([patientId])
  @@index([clinicId])
  @@index([encounterDate])
  @@map("clinical_records")
}

model Referral {
  id               String               @id @default(uuid())
  type             ReferralType
  status           ReferralStatus       @default(PENDING)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  fromClinicId     String
  toClinicId       String?
  patientId        String
  diagnosticOrders DiagnosticOrder[]
  medications      ReferralMedication[]
  tests            ReferralTest[]
  fromClinic       Clinic               @relation("FromClinic", fields: [fromClinicId], references: [id])
  patient          Patient              @relation(fields: [patientId], references: [id])
  toClinic         Clinic?              @relation("ToClinic", fields: [toClinicId], references: [id])

  @@index([status])
  @@index([fromClinicId])
  @@index([toClinicId])
  @@index([patientId])
  @@map("referrals")
}

model ReferralMedication {
  id         String    @id @default(uuid())
  drugName   String
  dosage     String?
  frequency  String?
  duration   String?
  route      String?
  notes      String?
  referralId String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?  @default(false)
  referral   Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([is_deleted])
  @@map("referral_medications")
}

model ReferralTest {
  id         String         @id @default(uuid())
  referralId String
  testId     String
  created_at DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?       @default(false)
  referral   Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  test       DiagnosticTest @relation(fields: [testId], references: [id])

  @@unique([referralId, testId])
  @@index([referralId])
  @@index([testId])
  @@map("referral_tests")
}

model Surgery {
  id                    String                @id @default(uuid())
  orRoom                Int
  startTime             DateTime
  endTime               DateTime
  status                SurgeryStatus         @default(SCHEDULED)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([createdAt])
  patientId             String
  patient               Patient               @relation(fields: [patientId], references: [id])
  departmentId          String
  department            Department            @relation(fields: [departmentId], references: [id])
  preoperativeRequestId String?               @unique
  preoperativeRequest   PreoperativeRequest?  @relation(fields: [preoperativeRequestId], references: [id], onDelete: SetNull)
  operationTypeId       String?
  operationType         OperationType?        @relation(fields: [operationTypeId], references: [id])
  anesthesiaType        String?
  disposition           SurgeryDisposition    @default(PENDING)
  admittedWardId        String?
  admittedWard          Ward?                 @relation(fields: [admittedWardId], references: [id])
  appointments          Appointment[]
  beds                  Bed[]
  teamMembers           SurgeryTeamMember[]
  intraoperativeEvents  IntraoperativeEvent[]
  followUps             PostOpFollowUp[]
  postoperativeNotes    PostoperativeNote[]
  dischargeSummary      DischargeSummary?
  transactions          Transaction[]

  @@index([status])
  @@index([patientId])
  @@index([departmentId])
  @@index([startTime])
  @@map("surgeries")
}

model PostOpFollowUp {
  id          String              @id @default(uuid())
  surgeryId   String
  patientId   String
  scheduledAt DateTime
  status      PostOpFollowUpStatus @default(SCHEDULED)
  completedAt DateTime?
  notes       String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  surgery     Surgery             @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  patient     Patient             @relation(fields: [patientId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])

  @@index([surgeryId])
  @@index([patientId])
  @@index([status])
  @@index([scheduledAt])
  @@map("post_op_follow_ups")
}

model PostoperativeNote {
  id        String   @id @default(uuid())
  surgeryId String
  content   String
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surgery   Surgery  @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([surgeryId])
  @@map("postoperative_notes")
}

model DischargeSummary {
  id            String   @id @default(uuid())
  surgeryId     String   @unique
  dischargeDate DateTime
  dischargeNotes String?
  medications   String?
  followUpInstructions String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  surgery       Surgery  @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@index([surgeryId])
  @@map("discharge_summaries")
}

model OperationType {
  id           String     @id @default(uuid())
  name         String
  nameAr       String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  isActive     Boolean    @default(true)
  price        Decimal?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  is_deleted   Boolean?   @default(false)
  surgeries    Surgery[]
  preoperativeRequests PreoperativeRequest[]

  @@index([isActive])
  @@index([is_deleted])
  @@index([departmentId])
  @@map("operation_types")
}

model ORRole {
  id          String               @id @default(uuid())
  name        String
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  is_deleted  Boolean?             @default(false)
  teamMembers SurgeryTeamMember[]

  @@index([isActive])
  @@index([is_deleted])
  @@map("or_roles")
}

model PreoperativeRequest {
  id               String              @id @default(uuid())
  departmentId     String
  patientId        String
  requestedById    String
  operationTypeId  String
  status           PreoperativeStatus  @default(REQUESTED)
  confirmedById    String?
  confirmedAt      DateTime?
  paidAt           DateTime?
  paidById         String?
  labOrderId       String?
  aScanOrderId     String?
  bScanOrderId     String?
  scheduledDate    DateTime?
  scheduledTime    String?
  scheduledById    String?
  cancelledReason  String?
  cancelledById    String?
  cancelledAt      DateTime?
  flaggedReason    String?
  referredTo       String?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  department       Department          @relation(fields: [departmentId], references: [id])
  patient          Patient             @relation(fields: [patientId], references: [id])
  operationType    OperationType       @relation(fields: [operationTypeId], references: [id])
  surgery          Surgery?
  waiver           ConsentWaiver?

  @@index([status])
  @@index([patientId])
  @@index([departmentId])
  @@index([operationTypeId])
  @@index([createdAt])
  @@map("preoperative_requests")
}

model ConsentWaiver {
  id                    String               @id @default(uuid())
  preoperativeRequestId String               @unique
  signedBy              String
  relationship          RelationshipType
  signedAt              DateTime
  documentUrl           String?
  witnessedById         String?
  isPrintable           Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  preoperativeRequest   PreoperativeRequest  @relation(fields: [preoperativeRequestId], references: [id])

  @@index([preoperativeRequestId])
  @@map("consent_waivers")
}

model SurgeryTeamMember {
  id        String   @id @default(uuid())
  surgeryId String
  userId    String?
  name      String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surgery   Surgery  @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  role      ORRole   @relation(fields: [roleId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([surgeryId])
  @@index([roleId])
  @@index([userId])
  @@map("surgery_team_members")
}

model IntraoperativeEventType {
  id         String                    @id @default(uuid())
  name       String
  isActive   Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  is_deleted Boolean?                  @default(false)
  events     IntraoperativeEvent[]

  @@index([isActive])
  @@index([is_deleted])
  @@map("intraoperative_event_types")
}

model IntraoperativeEvent {
  id             String                  @id @default(uuid())
  surgeryId      String
  timestamp      DateTime                @default(now())
  eventTypeId    String
  description    String?
  performedById  String
  createdAt      DateTime                @default(now())
  surgery        Surgery                 @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  eventType      IntraoperativeEventType @relation(fields: [eventTypeId], references: [id])

  @@index([surgeryId])
  @@index([eventTypeId])
  @@index([timestamp])
  @@map("intraoperative_events")
}

model Ward {
  id           String     @id @default(uuid())
  name         String
  nameAr       String?
  type         String?
  floor        String?
  capacity     Int?
  departmentId String?
  isActive     Boolean    @default(true)
  dailyRate    Decimal?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  is_deleted   Boolean?   @default(false)
  department        Department? @relation(fields: [departmentId], references: [id])
  beds              Bed[]
  admittedSurgeries Surgery[]
  wardRounds        WardRound[]

  @@index([isActive])
  @@index([is_deleted])
  @@index([departmentId])
  @@map("wards")
}

model Bed {
  id           String    @id @default(uuid())
  bedNumber    String
  wardId       String
  status       BedStatus @default(VACANT)
  patientId    String?
  surgeryId    String?
  assignedAt   DateTime?
  dischargedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ward         Ward      @relation(fields: [wardId], references: [id])
  patient      Patient?  @relation(fields: [patientId], references: [id])
  surgery      Surgery?  @relation(fields: [surgeryId], references: [id])
  vitals       InpatientVital[]
  nursingNotes NursingNote[]

  @@index([wardId])
  @@index([status])
  @@index([patientId])
  @@index([surgeryId])
  @@map("beds")
}

model InpatientVital {
  id              String   @id @default(uuid())
  bedId           String
  recordedAt      DateTime @default(now())
  temperature     Decimal?
  heartRate       Int?
  bloodPressureSystolic Int?
  bloodPressureDiastolic Int?
  respiratoryRate Int?
  oxygenSaturation Int?
  painScore       Int?
  recordedById    String
  notes           String?
  createdAt       DateTime @default(now())
  bed             Bed      @relation(fields: [bedId], references: [id], onDelete: Cascade)
  recordedBy      User     @relation(fields: [recordedById], references: [id])

  @@index([bedId])
  @@index([recordedAt])
  @@map("inpatient_vitals")
}

model NursingNote {
  id         String   @id @default(uuid())
  bedId      String
  content    String
  createdById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bed        Bed      @relation(fields: [bedId], references: [id], onDelete: Cascade)
  createdBy  User     @relation(fields: [createdById], references: [id])

  @@index([bedId])
  @@index([createdAt])
  @@map("nursing_notes")
}

model WardRound {
  id          String   @id @default(uuid())
  wardId      String
  date        DateTime
  doctorId    String
  notes       String?
  plan        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ward        Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  doctor      User     @relation(fields: [doctorId], references: [id])

  @@index([wardId])
  @@index([date])
  @@map("ward_rounds")
}

model InventoryItem {
  id                   String                 @id @default(uuid())
  name                 String
  nameAr               String?
  sku                  String                 @unique
  category             String
  quantity             Decimal                @default(0)
  price                Decimal                @default(0)
  minStock             Int                    @default(0)
  isActive             Boolean                @default(true)
  costPrice            Decimal?               @default(0)
  expiryDate           DateTime?
  packSize             Int                    @default(1) @map("pack_size")
  updated_at           DateTime               @updatedAt @db.Timestamptz(6)
  is_deleted           Boolean?               @default(false)
  locations            InventoryLocation[]
  transactions         InventoryTransaction[]
  purchaseOrderItems   PurchaseOrderItem[]
  requisitionItems     RequisitionItem[]
  supplierInvoiceItems SupplierInvoiceItem[]

  @@index([isActive])
  @@index([is_deleted])
  @@index([category])
  @@map("inventory_items")
}

model InventoryLocation {
  id         String        @id @default(uuid())
  name       String
  quantity   Int           @default(0)
  itemId     String
  created_at DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?      @default(false)
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([is_deleted])
  @@map("inventory_locations")
}

model InventoryTransaction {
  id         String        @id @default(uuid())
  type       String
  quantity   Decimal
  notes      String?
  createdAt  DateTime      @default(now())
  itemId     String
  unitCost   Decimal?
  updated_at DateTime      @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?      @default(false)
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([is_deleted])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model Transaction {
  id             String          @id @default(uuid())
  type           TransactionType
  amount         Decimal
  paymentMethod  PaymentMethod
  description    String?
  createdAt      DateTime        @default(now())
  shiftId        String
  cashierId      String
  cogs           Decimal         @default(0)
  departmentId   String?
  patientId      String?
  surgeryId      String?
  diagnosticOrderId String?
  appointmentId  String?
  imagingOrderId String?
  updated_at     DateTime        @updatedAt @db.Timestamptz(6)
  is_deleted     Boolean?        @default(false)
