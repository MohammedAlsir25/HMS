generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model Hospital {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  address                 String?
  phone                   String?
  email                   String?
  logoUrl                 String?
  type                    HospitalType?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  is_deleted              Boolean                  @default(false)
  settings                Json?
  users                   User[]
  roles                   Role[]
  clinics                 Clinic[]
  departments             Department[]
  expenses                Expense[]
  patients                Patient[]
  patientFiles            PatientFile[]
  appointments            Appointment[]
  vitalSigns              VitalSign[]
  symptoms                Symptom[]
  medications             Medication[]
  clinicalRecords         ClinicalRecord[]
  referrals               Referral[]
  referralMedications     ReferralMedication[]
  referralTests           ReferralTest[]
  surgeries               Surgery[]
  postOpFollowUps         PostOpFollowUp[]
  postoperativeNotes      PostoperativeNote[]
  dischargeSummaries      DischargeSummary[]
  operationTypes          OperationType[]
  preoperativeRequests    PreoperativeRequest[]
  consentWaivers          ConsentWaiver[]
  surgeryTeamMembers      SurgeryTeamMember[]
  intraoperativeEvents    IntraoperativeEvent[]
  wards                   Ward[]
  beds                    Bed[]
  inpatientVitals         InpatientVital[]
  nursingNotes            NursingNote[]
  wardRounds              WardRound[]
  inventoryItems          InventoryItem[]
  inventoryLocations      InventoryLocation[]
  inventoryTransactions   InventoryTransaction[]
  transactions            Transaction[]
  opticLabJobs            OpticLabJob[]
  shifts                  Shift[]
  cashMovements           CashMovement[]
  diagnosticOrders        DiagnosticOrder[]
  diagnosticOrderTests    DiagnosticOrderTest[]
  employees               Employee[]
  payrollRecords          PayrollRecord[]
  attendance              Attendance[]
  leaveRequests           LeaveRequest[]
  shiftTemplates          ShiftTemplate[]
  employeeShifts          EmployeeShift[]
  leaveBalances           LeaveBalance[]
  auditLogs               AuditLog[]
  accountsPayable         AccountsPayable[]
  suppliers               Supplier[]
  supplierInvoices        SupplierInvoice[]
  supplierInvoiceItems    SupplierInvoiceItem[]
  costCenters             CostCenter[]
  requisitions            Requisition[]
  requisitionItems        RequisitionItem[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderItems      PurchaseOrderItem[]
  fixedAssets             FixedAsset[]
  serviceItems            ServiceItem[]
  invoices                Invoice[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  notifications           Notification[]
  imagingOrders           ImagingOrder[]
  imagingFiles            ImagingFile[]
  clinicalTemplates       ClinicalTemplate[]
  labSamples              LabSample[]
  insuranceCompanies      InsuranceCompany[]
  insurancePolicies       InsurancePolicy[]
  insurancePricingRules   InsurancePricingRule[]
  preAuthorizations       PreAuthorization[]
  insuranceClaims         InsuranceClaim[]
  insuranceSettlements    InsuranceSettlement[]
  patientUsers            PatientUser[]
  notificationPreferences NotificationPreference[]
  triageAssessments       TriageAssessment[]
  paymentPlans            PaymentPlan[]
  creditMemos             CreditMemo[]
  refunds                 Refund[]
  badDebtWriteOffs        BadDebtWriteOff[]
  denialAppeals           DenialAppeal[]
  denialReasons           DenialReason[]
  fhirEndpoints           FhirEndpoint[]

  @@index([isActive])
  @@index([is_deleted])
  @@map("hospitals")
}

model User {
  id                         String                @id @default(uuid())
  email                      String
  passwordHash               String
  fullName                   String
  phone                      String?
  avatarUrl                  String?
  isActive                   Boolean               @default(true)
  lastLogin                  DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  roleId                     String
  clinicId                   String?
  hospitalId                 String?
  appointments               Appointment[]
  auditLogs                  AuditLog[]
  enteredResults             DiagnosticOrderTest[] @relation("ResultEnterer")
  assignedOrders             DiagnosticOrder[]     @relation("OrderAssignee")
  requestedOrders            DiagnosticOrder[]     @relation("OrderRequester")
  paidOrders                 DiagnosticOrder[]     @relation("OrderPaidBy")
  employees                  Employee[]
  approvedLeaves             LeaveRequest[]        @relation("LeaveApprover")
  notifications              Notification[]
  createdPatients            Patient[]             @relation("PatientCreator")
  approvedPurchaseOrders     PurchaseOrder[]       @relation("POApprover")
  createdPurchaseOrders      PurchaseOrder[]       @relation("POCreator")
  createdRequisitions        Requisition[]         @relation("RequisitionCreator")
  shifts                     Shift[]
  createdInvoices            SupplierInvoice[]
  cashierTransactions        Transaction[]         @relation("Cashier")
  clinic                     Clinic?               @relation(fields: [clinicId], references: [id])
  role                       Role                  @relation(fields: [roleId], references: [id])
  hospital                   Hospital?             @relation(fields: [hospitalId], references: [id])
  opticLabCompletedBy        OpticLabJob[]         @relation("OpticLabCompletedBy")
  opticLabCreatedBy          OpticLabJob[]         @relation("OpticLabCreatedBy")
  surgeryTeamMembers         SurgeryTeamMember[]
  createdFollowUps           PostOpFollowUp[]
  postoperativeNotes         PostoperativeNote[]
  dischargeSummaries         DischargeSummary[]
  inpatientVitals            InpatientVital[]
  nursingNotes               NursingNote[]
  wardRounds                 WardRound[]
  cashMovements              CashMovement[]
  clinicalTemplates          ClinicalTemplate[]
  collectedSamples           LabSample[]           @relation("SampleCollector")
  submittedPreAuthorizations PreAuthorization[]    @relation("SubmittedPreAuth")
  reviewedPreAuthorizations  PreAuthorization[]    @relation("ReviewedPreAuth")
  createdClaims              InsuranceClaim[]      @relation("CreatedClaim")
  createdSettlements         InsuranceSettlement[] @relation("CreatedSettlement")
  triageAssessments          TriageAssessment[]
  createdPaymentPlans        PaymentPlan[]         @relation("PlanCreator")
  createdCreditMemos         CreditMemo[]          @relation("CreditMemoCreator")
  createdRefunds             Refund[]              @relation("RefundCreator")
  createdWriteOffs           BadDebtWriteOff[]     @relation("WriteOffCreator")
  createdDenialAppeals       DenialAppeal[]        @relation("AppealCreator")

  @@unique([hospitalId, email])
  @@index([isActive])
  @@index([roleId])
  @@index([clinicId])
  @@index([hospitalId])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String
  description String?
  permissions Json      @default("{}")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  is_deleted  Boolean?  @default(false)
  hospitalId  String?
  users       User[]
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, name])
  @@index([is_deleted])
  @@index([hospitalId])
  @@map("roles")
}

model Clinic {
  id                            String            @id @default(uuid())
  name                          String
  nameAr                        String?
  slug                          String
  type                          ClinicType
  isActive                      Boolean           @default(true)
  consultationFee               Decimal?
  followUpFee                   Decimal?
  created_at                    DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime          @updatedAt @db.Timestamptz(6)
  is_deleted                    Boolean?          @default(false)
  optometryPreScreeningRequired Boolean           @default(false)
  hospitalId                    String?
  appointments                  Appointment[]
  clinicalRecords               ClinicalRecord[]
  departments                   Department[]
  diagnosticOrders              DiagnosticOrder[]
  referralsFrom                 Referral[]        @relation("FromClinic")
  referralsTo                   Referral[]        @relation("ToClinic")
  screeningAppointments         Appointment[]     @relation("TargetClinic")
  users                         User[]
  hospital                      Hospital?         @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, slug])
  @@index([isActive])
  @@index([is_deleted])
  @@index([hospitalId])
  @@map("clinics")
}

model Department {
  id                   String                @id @default(uuid())
  name                 String
  nameAr               String?
  slug                 String
  type                 DepartmentType
  isActive             Boolean               @default(true)
  clinicId             String?
  created_at           DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @updatedAt @db.Timestamptz(6)
  is_deleted           Boolean?              @default(false)
  hospitalId           String?
  costCenter           CostCenter?
  clinic               Clinic?               @relation(fields: [clinicId], references: [id])
  hospital             Hospital?             @relation(fields: [hospitalId], references: [id])
  employees            Employee[]
  expenses             Expense[]
  requisitions         Requisition[]
  transactions         Transaction[]
  surgeries            Surgery[]
  operationTypes       OperationType[]
  preoperativeRequests PreoperativeRequest[]
  wards                Ward[]

  @@unique([hospitalId, slug])
  @@index([isActive])
  @@index([is_deleted])
  @@index([clinicId])
  @@index([hospitalId])
  @@map("departments")
}

model Expense {
  id              String           @id @default(uuid())
  amount          Decimal
  category        ExpenseCategory
  description     String
  date            DateTime         @default(now())
  paidTo          String?
  paymentMethod   String?
  notes           String?
  receiptUrl      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  departmentId    String?
  hospitalId      String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  hospital        Hospital?        @relation(fields: [hospitalId], references: [id])
  purchaseOrders  PurchaseOrder?
  supplierInvoice SupplierInvoice?

  @@index([date])
  @@index([departmentId])
  @@index([category])
  @@index([hospitalId])
  @@index([hospitalId, date])
  @@map("expenses")
}

model Patient {
  id                   String                @id @default(uuid())
  mrn                  String
  fullName             String
  phone                String?
  nationalId           String?               @unique
  email                String?
  dateOfBirth          DateTime?
  gender               GenderType?          @default(UNKNOWN)
  structuredName       Json?
  chronicConditions    String[]              @default([])
  address              String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdById          String
  diabetesType         DiabetesType          @default(NONE)
  is_deleted           Boolean?              @default(false)
  hospitalId           String?
  appointments         Appointment[]
  clinicalRecords      ClinicalRecord[]
  diagnosticOrders     DiagnosticOrder[]
  files                PatientFile[]
  createdBy            User                  @relation("PatientCreator", fields: [createdById], references: [id])
  hospital             Hospital?             @relation(fields: [hospitalId], references: [id])
  referrals            Referral[]
  surgeries            Surgery[]
  preoperativeRequests PreoperativeRequest[]
  followUps            PostOpFollowUp[]
  beds                 Bed[]
  transactions         Transaction[]
  invoices             Invoice[]
  insurancePolicies    InsurancePolicy[]
  preAuthorizations    PreAuthorization[]
  insuranceClaims      InsuranceClaim[]
  portalUser           PatientUser?
  triageAssessments    TriageAssessment[]
  paymentPlans         PaymentPlan[]

  @@unique([hospitalId, mrn])
  @@index([is_deleted])
  @@index([createdAt])
  @@index([createdById])
  @@index([hospitalId])
  @@index([hospitalId, fullName])
  @@map("patients")
}

model PatientUser {
  id                      String                   @id @default(uuid())
  patientId               String                   @unique
  email                   String
  passwordHash            String
  phone                   String?
  phoneVerified           Boolean                  @default(false)
  emailVerified           Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  lastLoginAt             DateTime?
  hospitalId              String?
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  patient                 Patient                  @relation(fields: [patientId], references: [id])
  hospital                Hospital?                @relation(fields: [hospitalId], references: [id])
  notificationPreferences NotificationPreference[]

  @@unique([hospitalId, email])
  @@index([patientId])
  @@index([hospitalId])
  @@map("patient_users")
}

model NotificationPreference {
  id            String      @id @default(uuid())
  patientUserId String
  type          String
  channel       String
  enabled       Boolean     @default(true)
  hospitalId    String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  patientUser   PatientUser @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  hospital      Hospital?   @relation(fields: [hospitalId], references: [id])

  @@unique([patientUserId, type, channel])
  @@index([patientUserId])
  @@index([hospitalId])
  @@map("notification_preferences")
}

model PatientFile {
  id           String    @id @default(uuid())
  originalName String
  storedPath   String
  mimeType     String
  size         Int
  createdAt    DateTime  @default(now())
  patientId    String
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  is_deleted   Boolean?  @default(false)
  hospitalId   String?
  patient      Patient   @relation(fields: [patientId], references: [id])
  hospital     Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([patientId])
  @@index([is_deleted])
  @@index([hospitalId])
  @@map("patient_files")
}

model Appointment {
  id                String            @id @default(uuid())
  token             Int
  type              AppointmentType
  status            AppointmentStatus @default(WAITING)
  priority          Int               @default(0)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  patientId         String
  clinicId          String
  doctorId          String
  visitType         VisitType?        @default(NEW_VISIT)
  scheduledAt       DateTime?
  targetClinicId    String?
  optometryRecordId String?
  hospitalId        String?
  clinic            Clinic            @relation(fields: [clinicId], references: [id])
  doctor            User              @relation(fields: [doctorId], references: [id])
  patient           Patient           @relation(fields: [patientId], references: [id])
  hospital          Hospital?         @relation(fields: [hospitalId], references: [id])
  targetClinic      Clinic?           @relation("TargetClinic", fields: [targetClinicId], references: [id])
  surgeryId         String?
  surgery           Surgery?          @relation(fields: [surgeryId], references: [id])
  transactions      Transaction[]
  remindedAt        DateTime?
  calledAt          DateTime?
  completedAt       DateTime?

  @@index([status])
  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([targetClinicId])
  @@index([createdAt])
  @@index([hospitalId])
  @@index([hospitalId, doctorId, scheduledAt])
  @@index([hospitalId, patientId])
  @@index([hospitalId, status])
  @@map("appointments")
}

model Icd10Code {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  category   String?
  createdAt  DateTime @default(now())
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  is_deleted Boolean? @default(false)

  @@index([is_deleted])
  @@index([category])
  @@map("icd10_codes")
}

model VitalSign {
  id                     String         @id @default(uuid())
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  temperature            Decimal?
  spo2                   Int?
  bloodGlucose           Int?
  weight                 Decimal?
  recordedAt             DateTime       @default(now())
  clinicalRecordId       String
  created_at             DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted             Boolean?       @default(false)
  hospitalId             String?
  clinicalRecord         ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])
  hospital               Hospital?      @relation(fields: [hospitalId], references: [id])

  @@index([clinicalRecordId])
  @@index([is_deleted])
  @@index([hospitalId])
  @@map("vital_signs")
}

model Symptom {
  id               String         @id @default(uuid())
  name             String
  bodyArea         String?
  onset            String?
  duration         String?
  severity         Int?
  description      String?
  clinicalRecordId String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?       @default(false)
  hospitalId       String?
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])
  hospital         Hospital?      @relation(fields: [hospitalId], references: [id])

  @@index([clinicalRecordId])
  @@index([is_deleted])
  @@index([hospitalId])
  @@map("symptoms")
}

model Medication {
  id               String         @id @default(uuid())
  drugName         String
  dosage           String?
  frequency        String?
  duration         String?
  route            String?
  notes            String?
  clinicalRecordId String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?       @default(false)
  hospitalId       String?
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])
  hospital         Hospital?      @relation(fields: [hospitalId], references: [id])

  @@index([clinicalRecordId])
  @@index([is_deleted])
  @@index([hospitalId])
  @@map("medications")
}

model ClinicalRecord {
  id                 String       @id @default(uuid())
  encounterDate      DateTime     @default(now())
  diagnosis          String?
  prescriptions      String?
  clinicSpecificJson Json?        @default("{}")
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  patientId          String
  clinicId           String
  hospitalId         String?
  clinic             Clinic       @relation(fields: [clinicId], references: [id])
  patient            Patient      @relation(fields: [patientId], references: [id])
  hospital           Hospital?    @relation(fields: [hospitalId], references: [id])
  medications        Medication[]
  symptoms           Symptom[]
  vitalSigns         VitalSign[]

  @@index([createdAt])
  @@index([patientId])
  @@index([clinicId])
  @@index([encounterDate])
  @@index([hospitalId])
  @@index([hospitalId, clinicId])
  @@index([hospitalId, patientId])
  @@map("clinical_records")
}

model Referral {
  id               String               @id @default(uuid())
  type             ReferralType
  status           ReferralStatus       @default(PENDING)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  fromClinicId     String
  toClinicId       String?
  patientId        String
  hospitalId       String?
  diagnosticOrders DiagnosticOrder[]
  medications      ReferralMedication[]
  tests            ReferralTest[]
  fromClinic       Clinic               @relation("FromClinic", fields: [fromClinicId], references: [id])
  patient          Patient              @relation(fields: [patientId], references: [id])
  toClinic         Clinic?              @relation("ToClinic", fields: [toClinicId], references: [id])
  hospital         Hospital?            @relation(fields: [hospitalId], references: [id])

  @@index([status])
  @@index([fromClinicId])
  @@index([toClinicId])
  @@index([patientId])
  @@index([hospitalId])
  @@index([hospitalId, status])
  @@map("referrals")
}

model ReferralMedication {
  id         String    @id @default(uuid())
  drugName   String
  dosage     String?
  frequency  String?
  duration   String?
  route      String?
  notes      String?
  referralId String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?  @default(false)
  hospitalId String?
  referral   Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([referralId])
  @@index([is_deleted])
  @@index([hospitalId])
  @@map("referral_medications")
}

model ReferralTest {
  id         String         @id @default(uuid())
  referralId String
  testId     String
  created_at DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?       @default(false)
  hospitalId String?
  referral   Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  test       DiagnosticTest @relation(fields: [testId], references: [id])
  hospital   Hospital?      @relation(fields: [hospitalId], references: [id])

  @@unique([referralId, testId])
  @@index([referralId])
  @@index([testId])
  @@index([hospitalId])
  @@map("referral_tests")
}

model Surgery {
  id                    String                @id @default(uuid())
  orRoom                Int
  startTime             DateTime
  endTime               DateTime
  status                SurgeryStatus         @default(SCHEDULED)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  patientId             String
  hospitalId            String?
  patient               Patient               @relation(fields: [patientId], references: [id])
  departmentId          String
  department            Department            @relation(fields: [departmentId], references: [id])
  hospital              Hospital?             @relation(fields: [hospitalId], references: [id])
  preoperativeRequestId String?               @unique
  preoperativeRequest   PreoperativeRequest?  @relation(fields: [preoperativeRequestId], references: [id], onDelete: SetNull)
  operationTypeId       String?
  operationType         OperationType?        @relation(fields: [operationTypeId], references: [id])
  anesthesiaType        String?
  disposition           SurgeryDisposition    @default(PENDING)
  admittedWardId        String?
  admittedWard          Ward?                 @relation(fields: [admittedWardId], references: [id])
  appointments          Appointment[]
  beds                  Bed[]
  teamMembers           SurgeryTeamMember[]
  intraoperativeEvents  IntraoperativeEvent[]
  followUps             PostOpFollowUp[]
  postoperativeNotes    PostoperativeNote[]
  dischargeSummary      DischargeSummary?
  transactions          Transaction[]

  @@index([createdAt])
  @@index([status])
  @@index([patientId])
  @@index([departmentId])
  @@index([startTime])
  @@index([hospitalId])
  @@index([hospitalId, status])
  @@map("surgeries")
}

model PostOpFollowUp {
  id          String               @id @default(uuid())
  surgeryId   String
  patientId   String
  scheduledAt DateTime
  status      PostOpFollowUpStatus @default(SCHEDULED)
  completedAt DateTime?
  notes       String?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  hospitalId  String?
  surgery     Surgery              @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  patient     Patient              @relation(fields: [patientId], references: [id])
  createdBy   User                 @relation(fields: [createdById], references: [id])
  hospital    Hospital?            @relation(fields: [hospitalId], references: [id])

  @@index([surgeryId])
  @@index([patientId])
  @@index([status])
  @@index([scheduledAt])
  @@index([hospitalId])
  @@map("post_op_follow_ups")
}

model PostoperativeNote {
  id          String    @id @default(uuid())
  surgeryId   String
  content     String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hospitalId  String?
  surgery     Surgery   @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id])
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([surgeryId])
  @@index([hospitalId])
  @@map("postoperative_notes")
}

model DischargeSummary {
  id                   String    @id @default(uuid())
  surgeryId            String    @unique
  dischargeDate        DateTime
  dischargeNotes       String?
  medications          String?
  followUpInstructions String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  hospitalId           String?
  surgery              Surgery   @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  createdBy            User      @relation(fields: [createdById], references: [id])
  hospital             Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([surgeryId])
  @@index([hospitalId])
  @@map("discharge_summaries")
}

model OperationType {
  id                   String                @id @default(uuid())
  name                 String
  nameAr               String?
  departmentId         String
  isActive             Boolean               @default(true)
  price                Decimal?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  is_deleted           Boolean?              @default(false)
  hospitalId           String?
  department           Department            @relation(fields: [departmentId], references: [id])
  hospital             Hospital?             @relation(fields: [hospitalId], references: [id])
  surgeries            Surgery[]
  preoperativeRequests PreoperativeRequest[]

  @@index([isActive])
  @@index([is_deleted])
  @@index([departmentId])
  @@index([hospitalId])
  @@map("operation_types")
}

model ORRole {
  id          String              @id @default(uuid())
  name        String
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  is_deleted  Boolean?            @default(false)
  teamMembers SurgeryTeamMember[]

  @@index([isActive])
  @@index([is_deleted])
  @@map("or_roles")
}

model PreoperativeRequest {
  id              String             @id @default(uuid())
  departmentId    String
