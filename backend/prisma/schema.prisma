generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                @id @default(uuid())
  email                  String                @unique
  passwordHash           String
  fullName               String
  phone                  String?
  avatarUrl              String?
  isActive               Boolean               @default(true)
  lastLogin              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  roleId                 String
  clinicId               String?
  appointments           Appointment[]
  auditLogs              AuditLog[]
  enteredResults         DiagnosticOrderTest[] @relation("ResultEnterer")
  assignedOrders         DiagnosticOrder[]     @relation("OrderAssignee")
  requestedOrders        DiagnosticOrder[]     @relation("OrderRequester")
  employees              Employee[]
  approvedLeaves         LeaveRequest[]        @relation("LeaveApprover")
  notifications          Notification[]
  createdPatients        Patient[]             @relation("PatientCreator")
  approvedPurchaseOrders PurchaseOrder[]       @relation("POApprover")
  createdPurchaseOrders  PurchaseOrder[]       @relation("POCreator")
  createdRequisitions    Requisition[]         @relation("RequisitionCreator")
  shifts                 Shift[]
  createdInvoices        SupplierInvoice[]
  cashierTransactions    Transaction[]         @relation("Cashier")
  clinic                 Clinic?               @relation(fields: [clinicId], references: [id])
  role                   Role                  @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  permissions Json      @default("{}")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  is_deleted  Boolean?  @default(false)
  users       User[]

  @@map("roles")
}

model Clinic {
  id               String            @id @default(uuid())
  name             String
  nameAr           String?
  slug             String            @unique
  type             ClinicType
  isActive         Boolean           @default(true)
  consultationFee  Decimal?
  followUpFee      Decimal?
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?          @default(false)
  appointments     Appointment[]
  clinicalRecords  ClinicalRecord[]
  department       Department?
  diagnosticOrders DiagnosticOrder[]
  referralsFrom    Referral[]        @relation("FromClinic")
  referralsTo      Referral[]        @relation("ToClinic")
  users            User[]

  @@map("clinics")
}

model Department {
  id           String         @id @default(uuid())
  name         String
  nameAr       String?
  slug         String         @unique
  type         DepartmentType
  isActive     Boolean        @default(true)
  clinicId     String?        @unique
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted   Boolean?       @default(false)
  costCenter   CostCenter?
  clinic       Clinic?        @relation(fields: [clinicId], references: [id])
  employees    Employee[]
  expenses     Expense[]
  requisitions Requisition[]
  transactions Transaction[]

  @@map("departments")
}

model Expense {
  id              String           @id @default(uuid())
  amount          Decimal
  category        ExpenseCategory
  description     String
  date            DateTime         @default(now())
  paidTo          String?
  paymentMethod   String?
  notes           String?
  receiptUrl      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  purchaseOrders  PurchaseOrder?
  supplierInvoice SupplierInvoice?

  @@map("expenses")
}

model Patient {
  id                String            @id @default(uuid())
  mrn               String            @unique
  fullName          String
  phone             String?
  nationalId        String?           @unique
  email             String?
  dateOfBirth       DateTime?
  gender            String?
  chronicConditions String[]          @default([])
  address           String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String
  diabetesType      DiabetesType      @default(NONE)
  is_deleted        Boolean?          @default(false)
  appointments      Appointment[]
  clinicalRecords   ClinicalRecord[]
  diagnosticOrders  DiagnosticOrder[]
  files             PatientFile[]
  createdBy         User              @relation("PatientCreator", fields: [createdById], references: [id])
  referrals         Referral[]
  surgeries         Surgery[]

  @@map("patients")
}

model PatientFile {
  id           String   @id @default(uuid())
  originalName String
  storedPath   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  patientId    String
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  is_deleted   Boolean? @default(false)
  patient      Patient  @relation(fields: [patientId], references: [id])

  @@map("patient_files")
}

model Appointment {
  id          String            @id @default(uuid())
  token       Int
  type        AppointmentType
  status      AppointmentStatus @default(WAITING)
  priority    Int               @default(0)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  patientId   String
  clinicId    String
  doctorId    String
  visitType   VisitType?        @default(NEW_VISIT)
  scheduledAt DateTime?
  clinic      Clinic            @relation(fields: [clinicId], references: [id])
  doctor      User              @relation(fields: [doctorId], references: [id])
  patient     Patient           @relation(fields: [patientId], references: [id])

  @@map("appointments")
}

model Icd10Code {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  category   String?
  createdAt  DateTime @default(now())
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  is_deleted Boolean? @default(false)

  @@map("icd10_codes")
}

model VitalSign {
  id                     String         @id @default(uuid())
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  temperature            Decimal?
  spo2                   Int?
  bloodGlucose           Int?
  weight                 Decimal?
  recordedAt             DateTime       @default(now())
  clinicalRecordId       String
  created_at             DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted             Boolean?       @default(false)
  clinicalRecord         ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])

  @@map("vital_signs")
}

model Symptom {
  id               String         @id @default(uuid())
  name             String
  bodyArea         String?
  onset            String?
  duration         String?
  severity         Int?
  description      String?
  clinicalRecordId String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?       @default(false)
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])

  @@map("symptoms")
}

model Medication {
  id               String         @id @default(uuid())
  drugName         String
  dosage           String?
  frequency        String?
  duration         String?
  route            String?
  notes            String?
  clinicalRecordId String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?       @default(false)
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])

  @@map("medications")
}

model ClinicalRecord {
  id                 String       @id @default(uuid())
  encounterDate      DateTime     @default(now())
  diagnosis          String?
  prescriptions      String?
  clinicSpecificJson Json?        @default("{}")
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  patientId          String
  clinicId           String
  clinic             Clinic       @relation(fields: [clinicId], references: [id])
  patient            Patient      @relation(fields: [patientId], references: [id])
  medications        Medication[]
  symptoms           Symptom[]
  vitalSigns         VitalSign[]

  @@map("clinical_records")
}

model Referral {
  id               String               @id @default(uuid())
  type             ReferralType
  status           ReferralStatus       @default(PENDING)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  fromClinicId     String
  toClinicId       String?
  patientId        String
  diagnosticOrders DiagnosticOrder[]
  medications      ReferralMedication[]
  tests            ReferralTest[]
  fromClinic       Clinic               @relation("FromClinic", fields: [fromClinicId], references: [id])
  patient          Patient              @relation(fields: [patientId], references: [id])
  toClinic         Clinic?              @relation("ToClinic", fields: [toClinicId], references: [id])

  @@map("referrals")
}

model ReferralMedication {
  id         String    @id @default(uuid())
  drugName   String
  dosage     String?
  frequency  String?
  duration   String?
  route      String?
  notes      String?
  referralId String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?  @default(false)
  referral   Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@map("referral_medications")
}

model ReferralTest {
  id         String         @id @default(uuid())
  referralId String
  testId     String
  created_at DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?       @default(false)
  referral   Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  test       DiagnosticTest @relation(fields: [testId], references: [id])

  @@unique([referralId, testId])
  @@map("referral_tests")
}

model Surgery {
  id        String        @id @default(uuid())
  orRoom    Int
  startTime DateTime
  endTime   DateTime
  status    SurgeryStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id])

  @@map("surgeries")
}

model InventoryItem {
  id                   String                 @id @default(uuid())
  name                 String
  nameAr               String?
  sku                  String                 @unique
  category             String
  quantity             Decimal                @default(0)
  price                Decimal                @default(0)
  minStock             Int                    @default(0)
  isActive             Boolean                @default(true)
  costPrice            Decimal?               @default(0)
  expiryDate           DateTime?
  packSize             Int                    @default(1) @map("pack_size")
  updated_at           DateTime               @updatedAt @db.Timestamptz(6)
  is_deleted           Boolean?               @default(false)
  locations            InventoryLocation[]
  transactions         InventoryTransaction[]
  purchaseOrderItems   PurchaseOrderItem[]
  requisitionItems     RequisitionItem[]
  supplierInvoiceItems SupplierInvoiceItem[]

  @@map("inventory_items")
}

model InventoryLocation {
  id         String        @id @default(uuid())
  name       String
  quantity   Int           @default(0)
  itemId     String
  created_at DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?      @default(false)
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@map("inventory_locations")
}

model InventoryTransaction {
  id         String        @id @default(uuid())
  type       String
  quantity   Decimal
  notes      String?
  createdAt  DateTime      @default(now())
  itemId     String
  unitCost   Decimal?
  updated_at DateTime      @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?      @default(false)
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@map("inventory_transactions")
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Decimal
  paymentMethod PaymentMethod
  description   String?
  createdAt     DateTime        @default(now())
  shiftId       String
  cashierId     String
  cogs          Decimal         @default(0)
  departmentId  String?
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)
  is_deleted    Boolean?        @default(false)
  cashier       User            @relation("Cashier", fields: [cashierId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  shift         Shift           @relation(fields: [shiftId], references: [id])

  @@map("transactions")
}

model Shift {
  id            String        @id @default(uuid())
  openedAt      DateTime      @default(now())
  closedAt      DateTime?
  expectedTotal Decimal?
  actualTotal   Decimal?
  notes         String?
  userId        String
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)
  is_deleted    Boolean?      @default(false)
  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]

  @@map("shifts")
}

model DiagnosticTest {
  id            String                @id @default(uuid())
  orderType     DiagnosticOrderType
  code          String
  name          String
  nameAr        String?
  category      String
  specimen      String?
  unit          String?
  refRangeText  String?
  refRangeLow   Decimal?
  refRangeHigh  Decimal?
  lowCritical   Decimal?
  highCritical  Decimal?
  price         Decimal?
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  testOrders    DiagnosticOrderTest[]
  panelTests    DiagnosticPanelTest[]
  referralTests ReferralTest[]

  @@unique([orderType, code])
  @@map("diagnostic_tests")
}

model DiagnosticPanel {
  id         String                @id @default(uuid())
  orderType  DiagnosticOrderType
  name       String
  nameAr     String?
  isActive   Boolean               @default(true)
  created_at DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at DateTime              @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?              @default(false)
  orders     DiagnosticOrder[]
  panelTests DiagnosticPanelTest[]

  @@map("diagnostic_panels")
}

model DiagnosticPanelTest {
  panelId    String
  testId     String
  created_at DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?        @default(false)
  panel      DiagnosticPanel @relation(fields: [panelId], references: [id])
  test       DiagnosticTest  @relation(fields: [testId], references: [id])

  @@id([panelId, testId])
  @@map("diagnostic_panel_tests")
}

model DiagnosticOrder {
  id            String                @id @default(uuid())
  orderType     DiagnosticOrderType   @default(LAB)
  status        DiagnosticOrderStatus @default(SUBMITTED)
  priority      Int                   @default(0)
  clinicalNotes String?
  resultNotes   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  completedAt   DateTime?
  requestedById String
  fromClinicId  String
  patientId     String
  assignedToId  String?
  panelId       String?
  referralId    String?
  tests         DiagnosticOrderTest[]
  assignedTo    User?                 @relation("OrderAssignee", fields: [assignedToId], references: [id])
  fromClinic    Clinic                @relation(fields: [fromClinicId], references: [id])
  panel         DiagnosticPanel?      @relation(fields: [panelId], references: [id])
  patient       Patient               @relation(fields: [patientId], references: [id])
  referral      Referral?             @relation(fields: [referralId], references: [id])
  requestedBy   User                  @relation("OrderRequester", fields: [requestedById], references: [id])

  @@map("diagnostic_orders")
}

model DiagnosticOrderTest {
  id                String          @id @default(uuid())
  value             String?
  unit              String?
  refRangeLow       Decimal?
  refRangeHigh      Decimal?
  refRangeText      String?
  flag              ResultFlag      @default(NORMAL)
  notes             String?
  resultEnteredAt   DateTime?
  resultEnteredById String?
  isAbnormal        Boolean         @default(false)
  orderId           String
  testId            String
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @updatedAt @db.Timestamptz(6)
  is_deleted        Boolean?        @default(false)
  order             DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resultEnteredBy   User?           @relation("ResultEnterer", fields: [resultEnteredById], references: [id])
  test              DiagnosticTest  @relation(fields: [testId], references: [id])

  @@unique([orderId, testId])
  @@map("diagnostic_order_tests")
}

model Employee {
  id             String          @id @default(uuid())
  employeeCode   String          @unique
  fullName       String
  phone          String?
  email          String?
  position       String
  department     String
  baseSalary     Decimal         @default(0)
  hireDate       DateTime
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String?
  departmentId   String?
  gender         String?
  attendance     Attendance[]
  dept           Department?     @relation(fields: [departmentId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]

  @@map("employees")
}

model PayrollRecord {
  id         String        @id @default(uuid())
  period     String
  grossPay   Decimal
  deductions Decimal       @default(0)
  netPay     Decimal
  status     PayrollStatus @default(DRAFT)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  employeeId String
  updated_at DateTime      @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?      @default(false)
  employee   Employee      @relation(fields: [employeeId], references: [id])

  @@map("payroll_records")
}

model Attendance {
  id         String           @id @default(uuid())
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  employeeId String
  created_at DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @updatedAt @db.Timestamptz(6)
  is_deleted Boolean?         @default(false)
  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("attendance")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  status       LeaveStatus @default(PENDING)
  reason       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  employeeId   String
  approvedById String?
  approvedBy   User?       @relation("LeaveApprover", fields: [approvedById], references: [id])
  employee     Employee    @relation(fields: [employeeId], references: [id])

  @@map("leave_requests")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  userId     String
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  is_deleted Boolean? @default(false)
  user       User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model AccountsPayable {
  id            String        @id @default(uuid())
  creditor      String
  description   String
  amount        Decimal
  notes         String?
  amountPaid    Decimal       @default(0)
  createdAt     DateTime      @default(now())
  dueDate       DateTime?
  paymentStatus PaymentStatus @default(Pending)
  updatedAt     DateTime      @updatedAt

  @@map("accounts_payable")
}

model Supplier {
  id             String            @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  createdAt      DateTime          @default(now())
  category       String
  updated_at     DateTime          @updatedAt @db.Timestamptz(6)
  is_deleted     Boolean?          @default(false)
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]

  @@map("suppliers")
}

model SupplierInvoice {
  id            String                @id @default(uuid())
  invoiceNumber String?
  invoiceTotal  Decimal
  amountPaid    Decimal               @default(0)
  paymentStatus PaymentStatus         @default(Pending)
  category      String
  notes         String?
  receivedAt    DateTime              @default(now())
  createdAt     DateTime              @default(now())
  supplierId    String
  createdById   String
  expenseId     String?               @unique
  updated_at    DateTime              @updatedAt @db.Timestamptz(6)
  is_deleted    Boolean?              @default(false)
  items         SupplierInvoiceItem[]
  createdBy     User                  @relation(fields: [createdById], references: [id])
  expense       Expense?              @relation(fields: [expenseId], references: [id])
  supplier      Supplier              @relation(fields: [supplierId], references: [id])

  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id               String          @id @default(uuid())
  quantityReceived Int
  unitCost         Decimal
  totalLineCost    Decimal
  invoiceId        String
  itemId           String
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?        @default(false)
  invoice          SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item             InventoryItem   @relation(fields: [itemId], references: [id])

  @@map("supplier_invoice_items")
}

model CostCenter {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  isActive       Boolean         @default(true)
  departmentId   String          @unique
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @updatedAt @db.Timestamptz(6)
  is_deleted     Boolean?        @default(false)
  department     Department      @relation(fields: [departmentId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@map("cost_centers")
}

model Requisition {
  id            String            @id @default(uuid())
  requestNumber String?
  status        String            @default("DRAFT")
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  requestedById String
  departmentId  String
  items         RequisitionItem[]
  department    Department        @relation(fields: [departmentId], references: [id])
  requestedBy   User              @relation("RequisitionCreator", fields: [requestedById], references: [id])

  @@map("requisitions")
}

model RequisitionItem {
  id            String         @id @default(uuid())
  description   String
  quantity      Int
  notes         String?
  itemId        String?
  requisitionId String
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted    Boolean?       @default(false)
  item          InventoryItem? @relation(fields: [itemId], references: [id])
  requisition   Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@map("requisition_items")
}

model PurchaseOrder {
  id                  String              @id @default(uuid())
  orderNumber         String?
  status              String              @default("DRAFT")
  rejectionReason     String?
  departmentType      String
  expenseType         String
  invoiceTotal        Decimal
  amountPaid          Decimal             @default(0)
  notes               String?
  receivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  approvalTier        Int?
  approvedById        String?
  approvedAt          DateTime?
  supplierId          String
  createdById         String
  costCenterId        String?
  expenseId           String?             @unique
  assetId             String?             @unique
  cogsAccountId       String?
  labFeePaid          Decimal?
  installationFreight Decimal?
  usefulLifeYears     Int?
  requisitionIds      String[]            @default([])
  paymentStatus       PaymentStatus       @default(Pending)
  items               PurchaseOrderItem[]
  approvedBy          User?               @relation("POApprover", fields: [approvedById], references: [id])
  asset               FixedAsset?         @relation(fields: [assetId], references: [id])
  costCenter          CostCenter?         @relation(fields: [costCenterId], references: [id])
  createdBy           User                @relation("POCreator", fields: [createdById], references: [id])
  expense             Expense?            @relation(fields: [expenseId], references: [id])
  supplier            Supplier            @relation(fields: [supplierId], references: [id])

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  description      String?
  quantity         Int            @default(1)
  quantityReceived Int            @default(0)
  unitCost         Decimal
  totalLineCost    Decimal
  itemId           String?
  orderId          String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean?       @default(false)
  item             InventoryItem? @relation(fields: [itemId], references: [id])
  order            PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model FixedAsset {
  id                      String         @id @default(uuid())
  name                    String
  assetType               String
  acquisitionCost         Decimal
  installationCost        Decimal?       @default(0)
  totalCost               Decimal
  usefulLifeYears         Int
  salvageValue            Decimal?       @default(0)
  depreciationMethod      String         @default("straight-line")
  monthlyDepreciation     Decimal
  accumulatedDepreciation Decimal        @default(0)
  bookValue               Decimal
  purchaseDate            DateTime
  location                String?
  serialNumber            String?
  notes                   String?
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  purchaseOrder           PurchaseOrder?

  @@map("fixed_assets")
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  isRead     Boolean  @default(false)
  actionUrl  String?
  createdAt  DateTime @default(now())
  userId     String
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  is_deleted Boolean? @default(false)
  user       User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

